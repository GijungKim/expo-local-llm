{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [
    "tools/oxlint/anti-slop/**"
  ],
  "ignoreDependencies": [
    "@oxlint/plugins"
  ],
  "ignoreBinaries": [
    "xed"
  ],
  "jest": {
    "config": [
      "package.json"
    ]
  },
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/__tests__/**/*.test.ts",
        "src/__tests__/**/*.typecheck.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "example": {
      "entry": [
        "index.ts",
        "babel.config.js",
        "metro.config.js"
      ],
      "project": [
        "**/*.{js,ts,tsx}"
      ]
    }
  }
}
