{
  "name": "expo-local-llm",
  "version": "0.10.0",
  "description": "Expo module for on-device LLM inference via Apple Foundation Models (iOS) and Gemini Nano (Android)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "ios/*.swift",
    "ios/*.podspec",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src/main",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "node tools/build.mjs build",
    "check:size": "bun tools/check-size.mjs",
    "clean": "expo-module clean",
    "lint": "eslint src && oxlint .",
    "lint:anti-slop": "oxlint .",
    "lint:typed": "OXLINT_TSGOLINT_PATH=./node_modules/.bin/tsrs-lint oxlint --type-aware --config .oxlintrc.typed.json src",
    "knip": "knip --no-config-hints",
    "test": "expo-module test",
    "test:build-script": "node --test tools/build.test.mjs",
    "test:anti-slop": "node --test tools/oxlint/anti-slop/anti-slop.cases.ts",
    "test:typed-lint": "node --test tools/lint-typed.test.mjs",
    "typecheck": "tsrs --project tsconfig.json --noEmit",
    "test:types": "tsrs --project tsconfig.typecheck.json --noEmit",
    "prepare": "chmod +x node_modules/expo-module-scripts/bin/expo-module-* 2>/dev/null || true",
    "prepublishOnly": "node tools/build.mjs prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-local-llm",
    "llm",
    "on-device",
    "apple-intelligence",
    "gemini-nano",
    "foundation-models"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GijungKim/expo-local-llm.git"
  },
  "bugs": {
    "url": "https://github.com/GijungKim/expo-local-llm/issues"
  },
  "author": "GijungKim <tonykim970@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/GijungKim/expo-local-llm#readme",
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "10.13.0",
    "expo": "~58.0.17",
    "expo-module-scripts": "^56.0.2",
    "expo-modules-core": "~58.0.24",
    "jest-expo": "~58.0.12",
    "knip": "6.42.1",
    "oxlint": "1.89.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-test-renderer": "19.3.0",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo/node"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  }
}
