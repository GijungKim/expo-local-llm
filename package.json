{
  "name": "expo-local-llm",
  "version": "0.7.0",
  "description": "Expo module for on-device LLM inference via Apple Foundation Models (iOS) and Gemini Nano (Android)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "eslint src && oxlint .",
    "lint:anti-slop": "oxlint .",
    "knip": "knip --no-config-hints",
    "test": "expo-module test",
    "test:anti-slop": "node --test tools/oxlint/anti-slop/anti-slop.cases.ts",
    "test:types": "tsc --project tsconfig.typecheck.json --noEmit",
    "prepare": "chmod +x node_modules/expo-module-scripts/bin/expo-module-* 2>/dev/null || true",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-local-llm",
    "llm",
    "on-device",
    "apple-intelligence",
    "gemini-nano",
    "foundation-models"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GijungKim/expo-local-llm.git"
  },
  "bugs": {
    "url": "https://github.com/GijungKim/expo-local-llm/issues"
  },
  "author": "GijungKim <tonykim970@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/GijungKim/expo-local-llm#readme",
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@react-native/jest-preset": "0.87.1",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "10.11.0",
    "expo": "~57.0.28",
    "expo-module-scripts": "^56.0.2",
    "expo-modules-core": "~57.0.22",
    "jest-expo": "~57.0.6",
    "knip": "6.38.0",
    "oxlint": "1.88.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo/node"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  }
}
